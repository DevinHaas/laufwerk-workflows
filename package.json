{
  "name": "@devin/laufwerk-workflows",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun build ./web/index.html --outdir=dist --minify",
    "check": "tsc --noEmit",
    "dev": "bun --watch src/canvas/server.ts",
    "start": "bun src/canvas/server.ts",
    "test": "bun test"
  },
  "exports": {
    "./github-issue": "./src/workflows/github-issue/workflow.ts",
    "./issue-to-fix": "./src/workflows/issue-to-fix/workflow.ts",
    "./potential-customer-analysis": "./src/workflows/potential-customer-analysis/workflow.ts",
    "./components/after-run-cleanup": "./src/components/after-run-cleanup.ts",
    "./tasks/github-issue": "./src/tasks/github-issue.ts",
    "./tasks/potential-customer-analysis": "./src/tasks/potential-customer-analysis.ts"
  },
  "dependencies": {
    "@effect/workflow": "0.19.1",
    "@excalidraw/excalidraw": "0.18.0",
    "@laufwerk/execution": "0.0.1-alpha.12",
    "@laufwerk/sdk": "0.0.1-alpha.12",
    "effect": "3.22.1",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "7.0.2"
  }
}
